# ── Server only ──────────────────────────────────────────────────────────────
# Postgres connection for the platform (owner role; the app switches to the
# platform_app role per request so RLS applies). Supabase: use the pooler URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_dev
# Integration tests (the schema in this database is dropped and recreated).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/platform_test
# Set to "require" for hosted Postgres (Supabase, Neon, RDS).
DATABASE_SSL=
# Shared secret for the scheduled event-processing endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Public hostnames (production defaults: https://api.leanapp.io and https://app.leanapp.io).
PUBLIC_API_URL=http://localhost:3100
PUBLIC_APP_URL=http://localhost:3100
# Optional: events accepted per environment per minute (default 6000).
INGEST_EVENTS_PER_MINUTE=
