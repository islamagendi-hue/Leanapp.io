# ── Server only ──────────────────────────────────────────────────────────────
# Postgres connection for the platform (owner role; the app switches to the
# platform_app role per request so RLS applies). Supabase: use the pooler URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_dev
# Integration tests (the schema in this database is dropped and recreated).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/platform_test
# Set to "require" for hosted Postgres (Supabase, Neon, RDS).
DATABASE_SSL=
# Shared secret for the scheduled event-processing endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Public hostnames (production defaults: https://api.leanapp.io and https://app.leanapp.io).
PUBLIC_API_URL=http://localhost:3100
PUBLIC_APP_URL=http://localhost:3100
# Host of tracking / deep links (/l/…) and their /.well-known files. Production default: https://api.leanapp.io.
# A dedicated host (https://l.leanapp.io) is recommended; see docs/deep-links.md for DNS. Empty = PUBLIC_API_URL.
PUBLIC_LINK_URL=
# Optional: events accepted per environment per minute (default 6000).
INGEST_EVENTS_PER_MINUTE=
# Optional: events accepted per API key per minute (default 6000).
INGEST_EVENTS_PER_KEY_PER_MINUTE=
# Optional: events accepted per client IP per environment per minute, public SDK keys only (default 1200).
INGEST_EVENTS_PER_IP_PER_MINUTE=
# Management API (secret keys) requests per minute per environment. Default 600.
MANAGEMENT_API_REQUESTS_PER_MINUTE=
# Transactional email via Resend. Without these, development prints emails to the
# server log and production sends none (the UI says so).
RESEND_API_KEY=
EMAIL_FROM="LeanApp <no-reply@leanapp.io>"
# Plan retention (free plan: 30 days of events). Unset = report only; "enforce" = delete
# events and sessions past retention on each scheduled run. Deleting is irreversible.
EVENT_RETENTION=
# Public demo (/demo and the landing page's "Try the live demo"): "1" creates a read-only
# sample organization on first use and keeps its data current on each scheduled run.
DEMO_ENABLED=
# Payments (Stripe, docs/billing.md). Both or neither; without them the billing page
# says payments aren't connected and upgrades are disabled. Use sk_test_ keys locally.
# The key's prefix sets the mode (sk_test_/rk_test_ or sk_live_/rk_live_); the webhook secret must be
# the signing secret of the endpoint created in that same mode. Never commit either.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price ids (price_…) per self-serve plan and interval, created in the same mode as the key.
# A plan/interval without one can't be bought online. Checkout uses only prices the status check verified.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
# Optional: how long ingestion caches an organization's monthly event usage (default 30000 ms).
PLAN_USAGE_CACHE_MS=
# 32-byte key (base64 or 64 hex chars: `openssl rand -hex 32`) that encrypts customer credentials at rest:
# ad-network postback credentials, push / WhatsApp / email provider keys, and webhook signing secrets.
# Unset = those credentials can't be saved and the UI says so. Changing it makes stored secrets unreadable.
INTEGRATIONS_ENCRYPTION_KEY=
# Optional "Connect with …" buttons for ad reporting import (docs/integrations.md). Each needs LeanApp's own
# app registered with the provider, with redirect URI <PUBLIC_APP_URL>/integrations/oauth/<provider>/callback
# (meta_ads, google_ads, tiktok_ads, snapchat_ads). Unset = customers paste their own credentials instead.
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: Google Ads API version preset for OAuth connections (e.g. v21); otherwise each customer sets it.
GOOGLE_ADS_API_VERSION=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# Webhook URLs may not resolve to private/loopback addresses on deployments. Locally they may.
# Set to "1" to allow private addresses on a deployment (not recommended).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=
# Optional: Graph API version for WhatsApp (default v23.0).
WHATSAPP_GRAPH_VERSION=
# Secret for the keyed hash of visitor IPs on link clicks and installs (`openssl rand -base64 32`).
# Unset in a deployment = no IP hashes, so opt-in probabilistic matching never matches.
ATTRIBUTION_IP_HASH_SECRET=
# Optional: tracking-link clicks recorded per visitor per link per minute (default 20) and per environment (default 6000).
LINK_CLICKS_PER_IP_PER_MINUTE=
LINK_CLICKS_PER_ENV_PER_MINUTE=
# Monitoring and alerts (docs/ops/monitoring.md). All optional; with none set, reports only go to the server log.
# Slack- or Discord-compatible incoming webhook URL for error and worker alerts. Treat it as a secret.
ALERT_WEBHOOK_URL=
# Sentry project DSN (https://<key>@<host>/<project>), sent over plain HTTP without an SDK.
SENTRY_DSN=
# Read-only Bearer secret for GET /api/internal/worker-status, for an uptime monitor (CRON_SECRET also works there).
MONITORING_SECRET=
# Vercel Preview only (docs/ops/environments.md): branches whose previews may connect to a database,
# comma-separated. Default `staging`; every other preview refuses to connect. Normally leave unset.
PREVIEW_DB_BRANCHES=
# Media library storage (docs/media.md). Default "postgres": files are kept in the database, nothing else to set.
# "s3" = any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage's S3 endpoint, MinIO), signed with SigV4
# on the server; the bucket stays private and the app serves the files. Credentials never reach the browser.
MEDIA_STORAGE_DRIVER=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# "false" for virtual-hosted bucket URLs (bucket.endpoint); default path style (endpoint/bucket).
MEDIA_S3_FORCE_PATH_STYLE=
# Optional: largest upload in bytes (default 4194304 = 4 MB, under Vercel's 4.5 MB request limit; capped at 9 MB).
MEDIA_MAX_UPLOAD_BYTES=
